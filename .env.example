# ============================================================
# Zuigo Due Reminder — environment configuration
# Copy to .env and fill in the values for your deployment.
# ============================================================

# --- Core (required) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zuigo_due_reminder?schema=public"
SESSION_SECRET="change-me-32-chars-minimum"
JWT_SECRET="change-me-32-chars-minimum"
PORT=3000

# --- AI features (optional) ---
# GROQ_API_KEY="gsk_..."

# --- Automatic daily reminder dispatch (optional) ---
# AUTO_DISPATCH_TENANT="abmato"
# AUTO_DISPATCH_TIME="09:30"
# AUTO_DISPATCH_TZ="Asia/Kolkata"

# ============================================================
# Channel onboarding
# Each channel can be enabled purely via environment variables;
# credentials entered in the Settings UI take precedence.
# ============================================================

# Safe mode (default: true). While true, ALL messages are redirected to the
# override targets below and real customer contacts are never messaged.
# Set to "false" only when you are ready to send to real recipients.
# DISPATCH_SAFE_MODE=true
# OVERRIDE_TARGET_EMAIL="you@example.com"
# OVERRIDE_TARGET_PHONE="+911234567890"

# --- Email (SMTP; e.g. Gmail app password, Hostinger mail, SES SMTP) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM_EMAIL="accounts@yourcompany.com"
# SMTP_FROM_NAME="Accounts Department"

# --- WhatsApp (pick ONE provider) ---
# Meta WhatsApp Cloud API:
# WHATSAPP_META_ACCESS_TOKEN="EAAG..."
# WHATSAPP_META_PHONE_NUMBER_ID="123456789012345"
# ...or Twilio WhatsApp:
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_WHATSAPP_FROM="+14155238886"

# --- SMS (pick ONE provider) ---
# Fast2SMS (India):
# FAST2SMS_API_KEY="..."
# ...or Twilio SMS (TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN as above):
# TWILIO_SMS_FROM="+1..."
