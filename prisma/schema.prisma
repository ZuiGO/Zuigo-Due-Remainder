datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | MANAGER | VIEWER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                        String              @id @default(cuid())
  rawLedgerName             String
  normalizedName            String              @unique
  station                   String?
  branchName                String?
  branchCode                String?
  status                    String              @default("ACTIVE") // ACTIVE | FLAGGED | SETTLED | EXCLUDED
  isFlagged                 Boolean             @default(false)
  flaggedAt                 DateTime?
  flagReason                String?
  consecutiveRemindersCount Int                 @default(0)
  overallPriority           String              @default("Medium") // High | Medium | Low
  totalOutstanding          Float               @default(0)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  contacts                  CustomerContact[]
  invoices                  Invoice[]
  reminderSchedules         ReminderSchedule[]
  reminderLogs              ReminderLog[]
}

model CustomerContact {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  personName      String?
  mobileNumber    String?
  mobileNumber2   String?
  mobileNumber3   String?
  mobileNumber4   String?
  emailId         String?
  emailId2        String?
  emailId3        String?
  emailId4        String?
  isPrimary       Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model Invoice {
  id                 String           @id @default(cuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billNo             String
  billDate           DateTime
  dueDate            DateTime
  billAmount         Float
  adjustment         Float            @default(0)
  outstandingAmount  Float
  daysOverdue        Int              @default(0)
  agingBucket        String           @default("Not Yet Due") // Not Yet Due | 1-30 Days | 31-60 Days | 61-90 Days | 90+ Days
  actionType         String           @default("Follow-up Required") // Follow-up Required | Credit Balance - No Action
  priority           String           @default("Medium") // High | Medium | Low
  followUpChannel    String           @default("Email + SMS")
  remainderFrequency String?
  status             String           @default("Pending") // Pending | Payment Received | Partially Paid | Promise to Pay | Disputed | Escalated | Legal Notice
  narration          String?
  lastFollowUpDate   DateTime?
  nextFollowUpDate   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  payments           PaymentRecord[]
  installments       Installment[]
  reminderLogs       ReminderLog[]
}

model Installment {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Float
  dueDate           DateTime
  status            String   @default("PENDING") // PENDING | PAID
  createdAt         DateTime @default(now())
}

model PaymentRecord {
  id              String    @id @default(cuid())
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid      Float
  paymentDate     DateTime  @default(now())
  paymentMode     String    @default("BANK_TRANSFER") // UPI | NEFT_RTGS | CHEQUE | CASH | EXCEL_IMPORT
  referenceNumber String?   // UTR / Cheque No
  notes           String?
  createdAt       DateTime  @default(now())
}

model ReminderSchedule {
  id                     String    @id @default(cuid())
  customerId             String?   // Null for global system default
  customer               Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminder1DaysBefore    Int       @default(3)
  reminder2DaysAfter     Int       @default(0)
  reminder3DaysAfter     Int       @default(3)
  reminder4DaysAfter     Int       @default(7)
  reminder5DaysAfter     Int       @default(15)
  maxRemindersBeforeFlag Int       @default(5)
  channels               String    @default("WHATSAPP,SMS,EMAIL")
  autoReminderEnabled    Boolean   @default(true)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model MessageTemplate {
  id           String        @id @default(cuid())
  channel      String        // WHATSAPP | SMS | EMAIL
  name         String
  category     String        // GENTLE | ON_DUE | OVERDUE | URGENT | FINAL_NOTICE | PAYMENT_RECEIPT | AI_CUSTOM
  subject      String?       // Used for emails
  templateBody String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reminderLogs ReminderLog[]
}

model IntegrationSetting {
  id           String   @id @default(cuid())
  providerType String   // WHATSAPP | SMS | EMAIL | GROQ_AI
  providerName String   // META_CLOUD_API | TWILIO | MSG91 | SMTP | GROQ | SIMULATOR
  configJson   String   // JSON payload with credentials
  isEnabled    Boolean  @default(true)
  isSandbox    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ReminderLog {
  id                 String           @id @default(cuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  templateId         String?
  template           MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel            String           // WHATSAPP | SMS | EMAIL
  triggerType        String           @default("AUTOMATIC") // AUTOMATIC | MANUAL
  recipient          String
  status             String           @default("SENT") // QUEUED | SENT | DELIVERED | FAILED
  messageContent     String
  providerResponseId String?
  errorMessage       String?
  dispatchedAt       DateTime         @default(now())
}
